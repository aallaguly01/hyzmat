# === VPS / docker-compose.yml ===
DOMAIN=aljak.me
BOT_TOKEN=123456789:replace-with-real-token
# username бота без @ — нужен и для сборки web, и для ссылок бота
BOT_USERNAME=hyzmat_bot
# ключ для Cloudflare Worker бота (тот же, что SERVER_API_KEY в Worker): openssl rand -hex 24
BOT_API_KEY=
POSTGRES_PASSWORD=change-me
IMAGE_TAG=latest
API_IMAGE=ghcr.io/owner/hyzmat-api
WEB_IMAGE=ghcr.io/owner/hyzmat-web

# === Локальная разработка (apps/api) ===
# DATABASE_URL=postgresql://hyzmat:hyzmat@localhost:5432/hyzmat
# BOT_TOKEN=123456:DEV-TOKEN

# === Локальная разработка (apps/web, вне Telegram) ===
# VITE_MOCK_TELEGRAM=true
# VITE_DEV_BOT_TOKEN=123456:DEV-TOKEN
# VITE_MOCK_USERNAME=dev
