# === VPS / docker-compose.yml ===
DOMAIN=aljak.me
BOT_TOKEN=123456789:replace-with-real-token
BOT_USERNAME=hyzmat_bot
# секрет webhook бота (/start): openssl rand -hex 32
BOT_WEBHOOK_SECRET=change-me-random
POSTGRES_PASSWORD=change-me
IMAGE_TAG=latest
API_IMAGE=ghcr.io/owner/hyzmat-api
WEB_IMAGE=ghcr.io/owner/hyzmat-web

# === Локальная разработка (apps/api) ===
# DATABASE_URL=postgresql://hyzmat:hyzmat@localhost:5432/hyzmat
# BOT_TOKEN=123456:DEV-TOKEN

