# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @hyzmat/web...
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/web apps/web

ARG VITE_BOT_USERNAME=""
# Только для E2E/демо-стендов: включает мок Telegram. В проде не задавать!
ARG VITE_MOCK_TELEGRAM="false"
ARG VITE_DEV_BOT_TOKEN=""
ENV VITE_BOT_USERNAME=$VITE_BOT_USERNAME \
    VITE_MOCK_TELEGRAM=$VITE_MOCK_TELEGRAM \
    VITE_DEV_BOT_TOKEN=$VITE_DEV_BOT_TOKEN
RUN pnpm --filter @hyzmat/web build

FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
